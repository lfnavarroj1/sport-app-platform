[submodule "components/backend"]
	path = components/backend
	url = https://github.com/lfnavarroj1/sport-app-backend.git
	update = none
	fetchRecurseSubmodules = false
[submodule "components/frontend"]
	path = components/frontend
	url = https://github.com/lfnavarroj1/sport-app-frontend.git
	update = none
	fetchRecurseSubmodules = false
[submodule "components/mobile"]
	path = components/mobile
	url = https://github.com/lfnavarroj1/sport-app-movil.git
	update = none
	fetchRecurseSubmodules = false
