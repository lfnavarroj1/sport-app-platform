# Copiar a gcp.auto.tfvars (ignorado por Git). Sin credenciales. Esta raíz se
# aplica desde la estación del operador; Cloud Deploy despliega las cargas.

project_id   = "sportapp-prod-1234"
state_bucket = "sportapp-mgmt-1234-tfstate-production"
impersonate_service_account = "tf-apply-production@sportapp-mgmt-1234.iam.gserviceaccount.com"

# Las imágenes ya no se declaran aquí: Cloud Deploy las promueve por digest.
