# Copiar a backend.hcl (ignorado por Git) y ejecutar desde la estación del operador:
#   terraform init "-backend-config=backend.hcl"
# Mismo bucket que environments/production; el prefijo está en versions.tf.
bucket                      = "sportapp-mgmt-1234-tfstate-production"
impersonate_service_account = "tf-apply-production@sportapp-mgmt-1234.iam.gserviceaccount.com"
